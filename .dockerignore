# The image is a deployment of this repository, not a copy of a working tree:
# history, editor droppings and anything a local run generated stay out.
.git
.gitignore
.githooks
.github
node_modules
*.log
.env
.env.local
dashboard/data.js
# Written *inside* the image by the Dockerfile's version stamp. Copying a host
# copy in would overwrite CI's answer with whatever some earlier local build
# left lying about, so a node could report a version it is not running.
build-info.json
