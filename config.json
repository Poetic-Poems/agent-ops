{
  "repos": [
    {
      "slug": "Poetic-Poems/poetic",
      "sources": ["security", "issues:urgent", "review-feedback", "merge-conflicts", "dequeued", "human-visibility", "abandoned-drafts", "failed-runs", "issues:high", "tech-debt", "issues:medium", "project-review", "issues:low", "code-quality", "register-hygiene"]
    },
    {
      "slug": "Poetic-Poems/poetic-fiddle",
      "sources": ["security", "issues:urgent", "review-feedback", "merge-conflicts", "dequeued", "human-visibility", "abandoned-drafts", "failed-runs", "issues:high", "tech-debt", "issues:medium", "implementation-plan", "project-review", "issues:low", "code-quality", "register-hygiene"],
      "nice": 6,
      "implementation_plan_path": "docs/IMPLEMENTATION-PLAN.md"
    },
    {
      "slug": "Poetic-Poems/agent-ops",
      "sources": ["security", "issues:urgent", "review-feedback", "merge-conflicts", "dequeued", "human-visibility", "abandoned-drafts", "failed-runs", "issues:high", "tech-debt", "issues:medium", "issues:low", "code-quality", "register-hygiene"],
      "nice": -18
    }
  ],
  "state_dir": "~/.local/state/poetic-agents",
  "workspace_root": "~/.cache/poetic-agents/workspaces",
  "state_repo": "Poetic-Poems/agent-ops-state",
  "cycles_retained": 200,
  "state_local_cycles_retained": 1000,
  "state_local_streams_retained": 50,
  "log_retained_bytes": 2000000,
  "log_generations": 3,
  "coordinator_model": "claude-haiku-4-5-20251001",
  "implementor_model_default": "claude-sonnet-5",
  "implementor_model_trivial": "claude-haiku-4-5-20251001",
  "reviewer_model_default": "claude-sonnet-5",
  "reviewer_model_complex": "claude-opus-5",
  "enabler_model": "claude-opus-5",
  "enabler_assignee": "warwickallen",
  "pr_label": "autonomous-agent",
  "branch_prefix": "agent/",
  "max_open_agent_prs": 8,
  "candidates_max": 3,
  "max_chained_cycles": 3,
  "claim_ttl_hours": 6,
  "abandoned_draft_after_hours": 4,
  "human_nudge_idle_hours": 24,
  "enabler_after_coordinator_cycles": 3,
  "enabler_recheck_hours": 72,
  "enabler_escalation_label": "enabler-escalation",
  "crash_loop_after": 4,
  "crash_loop_repo": "Poetic-Poems/agent-ops",
  "unvoid_label": "unvoided",
  "needs_refinement_label": "needs-refinement",
  "refinement_max_per_engagement": 3,
  "image_behind_grace_hours": 3,
  "limit_cooldown_default": 3,
  "disable_default_ttl": 4,
  "none_selected_recheck_hours": 24,
  "dashboard_refresh_seconds": 5,
  "schedule": {
    "cycle_hours": "*",
    "cycle_interval_minutes": 15,
    "excluded_minutes": [0],
    "excluded_minutes_reason": "poetic's hourly sync workflow owns the top of the hour",
    "review_hour": 3,
    "review_offset_minutes": 29,
    "heartbeat_minutes": 5,
    "state_sync_push_minutes": 5,
    "state_sync_fetch_minutes": 7,
    "log_rotation_minute": 19
  },
  "review": {
    "repos": ["Poetic-Poems/poetic", "Poetic-Poems/poetic-fiddle"],
    "model": "claude-sonnet-5",
    "pr_label": "project-review",
    "branch_prefix": "review/",
    "min_days_between_reviews": 13,
    "not_before": "2026-07-30T16:00:00Z"
  }
