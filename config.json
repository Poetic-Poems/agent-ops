{
  "repos": [
    {
      "slug": "Poetic-Poems/poetic",
      "sources": ["security", "issues:urgent", "review-feedback", "merge-conflicts", "abandoned-drafts", "failed-runs", "issues:high", "tech-debt", "issues:medium", "project-review", "issues:low", "code-quality"]
    },
    {
      "slug": "Poetic-Poems/poetic-fiddle",
      "sources": ["security", "issues:urgent", "review-feedback", "merge-conflicts", "abandoned-drafts", "failed-runs", "issues:high", "tech-debt", "issues:medium", "implementation-plan", "project-review", "issues:low", "code-quality"]
    },
    {
      "slug": "Poetic-Poems/agent-ops",
      "sources": ["security", "issues:urgent", "review-feedback", "merge-conflicts", "abandoned-drafts", "failed-runs", "issues:high", "tech-debt", "issues:medium", "issues:low", "code-quality"]
    }
  ],
  "state_dir": "~/.local/state/poetic-agents",
